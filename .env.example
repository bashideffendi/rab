# ─────────────────────────────────────────────────────────────────────────
# RABin — environment variables.
#   cp .env.example .env.local   lalu isi value-nya.
# .env.local di-GITIGNORE (jangan pernah commit). Minta value asli ke pemilik
# project lewat channel aman (password manager) — BUKAN lewat chat / repo.
# ─────────────────────────────────────────────────────────────────────────

# [WAJIB] Postgres connection string (Supabase / Neon / lokal).
# Supabase: Project Settings → Database → Connection string (URI).
DATABASE_URL="postgres://user:password@host:5432/rabin"

# [WAJIB] Supabase auth (session / magic link).
# Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi...anon-public-key..."

# [OPSIONAL] Fitur "Generate RAB via AI". Tanpa key ini app tetap jalan,
# cuma tombol AI yang mati. Anthropic API key.
ANTHROPIC_API_KEY="sk-ant-..."
# Model override (ada default di kode kalau dikosongin).
ANTHROPIC_MODEL=""

# [OPSIONAL] Data regional BPS (IKK / harga daerah).
BPS_API_KEY=""

# [OPSIONAL] URL publik untuk meta/OG tags.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [SCRIPT SAJA] Dipakai scripts/seed-*.ts (bukan runtime app).
# SEED_USER_ID="<uuid-user-supabase>"
